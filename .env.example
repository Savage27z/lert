# Copy to .env.local and fill in. Never commit real values.

# Public site origin (used for canonical URLs, sitemap, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings -> API). The anon/publishable key is safe for the
# browser: every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by scripts/bootstrap-owner.mjs and (later) payment
# webhooks. NEVER expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
